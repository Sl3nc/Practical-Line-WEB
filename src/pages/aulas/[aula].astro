---
import { getImage } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import ExerciseSection from "../../components/ExerciseSection";
import CodeBlock from "../../components/CodeBlock";
import { aulas, type Aula } from "../../data/aulas";
import "../../styles/activity.css";

export function getStaticPaths() {
  return aulas.map((aula) => ({
    params: { aula: String(aula.number) },
    props: { aula },
  }));
}

interface Props {
  aula: Aula;
}

const { aula } = Astro.props;

const exercises = await Promise.all(
  aula.exercises.map(async (exercise, index) => ({
    ...exercise,
    image: await getImage({
      src: exercise.image.src,
      alt: exercise.image.alt,
      width: 620,
      widths: [620, 1240],
      sizes: "(min-width: 620px) 620px, 100vw",
      format: "webp",
      quality: 80,
      priority: index < 2,
    }),
  })),
);
---

<Layout title={`Atividade Aula ${aula.number}- Linha Prática`} logoHref="/">
  <main>
    <h1>{aula.heading}</h1>
    {
      exercises.map(({ code, ...exercise }) => (
        <ExerciseSection {...exercise}>
          {code && <CodeBlock client:load code={code} />}
        </ExerciseSection>
      ))
    }
  </main>
</Layout>
